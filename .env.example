# MySQL / MariaDB connection string (Hostinger: hPanel > Databases > MySQL; Vercel: any hosted MySQL)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
# Long random string used to sign admin sessions. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# Public URL of the site, no trailing slash (used for SEO canonical links + sitemap)
SITE_URL="https://www.example.com"
# First admin account, created by: npm run db:seed
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# ── Email alerts for new contact-form enquiries (optional — leave SMTP_HOST empty to turn off) ──
# Hostinger email: smtp.hostinger.com, port 465. Gmail: smtp.gmail.com, port 465 with an App Password.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Sender address (usually the same mailbox as SMTP_USER)
MAIL_FROM=""
# Who receives alerts, comma-separated. If empty, the email in Admin → Settings is used.
CONTACT_ALERT_TO=""
