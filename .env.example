# MySQL / MariaDB connection string (Hostinger: hPanel > Databases > MySQL; Vercel: any hosted MySQL)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
# Long random string used to sign admin sessions. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# Public URL of the site, no trailing slash (used for SEO canonical links + sitemap)
SITE_URL="https://www.example.com"
# First admin account, created by: npm run db:seed
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
